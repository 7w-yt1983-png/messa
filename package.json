{
  "name": "messa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thoughtful, self-hosted messenger. No runtime dependencies.",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node tests/browser.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  }
}
