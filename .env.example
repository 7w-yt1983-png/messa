# Local development. Copy to .env. Never commit the real .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
ALLOW_REGISTRATION=true
# Production: require HTTPS and either disable signup or set a private invitation code.
# REGISTRATION_CODE=generate-at-least-20-random-characters-outside-this-repository
